---
const currentPath = Astro.url.pathname;
---
<header class="header">
  <nav class="container container-wide header-nav" aria-label="Main navigation">
    <a href="/" class="header-brand" aria-label="Quake home">
      <img src="/images/logo-q-transparent.png" alt="" class="brand-logo-q" width="591" height="794" loading="eager" />
      <span class="brand-suffix">uake</span>
    </a>
    <ul class="header-links" role="list">
      <li><a href="/services/" class:list={[{ active: currentPath.startsWith("/services") }]}>Services</a></li>
      <li><a href="/work/" class:list={[{ active: currentPath.startsWith("/work") }]}>Work</a></li>
      <li><a href="/about/" class:list={[{ active: currentPath.startsWith("/about") }]}>About</a></li>
      <li><a href="/contact/" class="header-cta">Let’s talk</a></li>
    </ul>
  </nav>
</header>
<style>
  .header { position: sticky; inset: 0 0 auto; z-index: 100; height: 56px; color:#fff; background:#1d1d1f; }
  .header-nav { height:56px; display:flex; align-items:center; justify-content:space-between; }
  .header-brand { display:inline-flex; align-items:center; gap:0; color:#fff; text-decoration:none; }
  .header-brand:hover { color:#fff; }
  .brand-logo-q { width:auto; height:31px; object-fit:contain; }
  .brand-suffix { color:#fff; font-size:1.35rem; line-height:1; font-weight:600; letter-spacing:-.045em; margin-left:-2px; }
  .header-links { display:flex; align-items:center; gap:clamp(1rem,3vw,2.5rem); list-style:none; margin:0; padding:0; }
  .header-links a { color:#f5f5f7; text-decoration:none; font-size:.9rem; }
  .header-links a:hover,.header-links a.active { color:#fff; }
  .header-links .header-cta { display:inline-flex; align-items:center; justify-content:center; padding:.55rem 1.15rem; background:#0066cc; color:#fff; }
  @media(max-width:560px) { .header-nav { padding-inline:1rem; } .header-links { gap:.8rem; } .header-links a { font-size:.78rem; } .brand-logo-q { height:27px; } .brand-suffix { font-size:1.15rem; } .header-links .header-cta { padding:.45rem .8rem; } }
  @media(max-width:390px) { .header-links li:nth-child(3) { display:none; } .header-links { gap:.7rem; } }
</style>
