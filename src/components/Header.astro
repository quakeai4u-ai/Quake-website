---
/*
  Header — Premium Glass Effect with Custom Wordmark
  ==================================================
  Features the custom vibrant Q logo as the first letter of "Quake".
  Noticeably sized, prominent, with subtle ambient glow.
*/
const currentPath = Astro.url.pathname;
---

<header class="header">
  <nav class="container container-wide header-nav" aria-label="Main navigation">
    <a href="/" class="header-brand" aria-label="Quake Home">
      <div class="logo-wrapper">
        <img
          src="/images/logo-q-transparent.png"
          alt="Q"
          class="brand-logo-q"
          width="591"
          height="794"
          loading="eager"
        />
        <span class="brand-suffix">uake</span>
      </div>
    </a>

    <ul class="header-links" role="list">
      <li>
        <a href="/services/" class:list={[{ active: currentPath.startsWith("/services") }]}>
          Services
        </a>
      </li>
      <li>
        <a href="/work/" class:list={[{ active: currentPath.startsWith("/work") }]}>
          Work
        </a>
      </li>
      <li>
        <a href="/about/" class:list={[{ active: currentPath.startsWith("/about") }]}>
          About
        </a>
      </li>
      <li>
        <button id="theme-toggle" class="theme-toggle" aria-label="Toggle light/dark theme" title="Toggle theme">
          <!-- Sun icon (shown in dark mode to switch to light) -->
          <svg class="theme-icon sun-icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <circle cx="12" cy="12" r="5"></circle>
            <line x1="12" y1="1" x2="12" y2="3"></line>
            <line x1="12" y1="21" x2="12" y2="23"></line>
            <line x1="4.22" y1="4.22" x2="5.64" y2="5.64"></line>
            <line x1="18.36" y1="18.36" x2="19.78" y2="19.78"></line>
            <line x1="1" y1="12" x2="3" y2="12"></line>
            <line x1="21" y1="12" x2="23" y2="12"></line>
            <line x1="4.22" y1="19.78" x2="5.64" y2="18.36"></line>
            <line x1="18.36" y1="5.64" x2="19.78" y2="4.22"></line>
          </svg>
          <!-- Moon icon (shown in light mode to switch to dark) -->
          <svg class="theme-icon moon-icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"></path>
          </svg>
        </button>
      </li>
      <li>
        <a href="/contact/" class="header-cta">
          Get in Touch
        </a>
      </li>
    </ul>
  </nav>
</header>

<style>
  .header {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    z-index: 100;
    background: rgba(18, 12, 34, 0.65);
    backdrop-filter: blur(20px);
    -webkit-backdrop-filter: blur(20px);
    border-bottom: 1px solid rgba(255, 255, 255, 0.08);
    transition: background 0.3s ease;
  }

  .header-nav {
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: 5.25rem; /* Spacious height to allow noticeable logo */
  }

  /* --- Brand & Custom Wordmark --- */
  .header-brand {
    display: inline-flex;
    align-items: center;
    text-decoration: none;
    color: #ffffff;
    user-select: none;
    padding: 0.25rem 0;
  }

  .header-brand:hover {
    text-decoration: none;
    color: #ffffff;
  }

  .logo-wrapper {
    display: inline-flex;
    align-items: center;
    gap: 0; /* Q and 'uake' blend together seamlessly */
    transition: transform 0.25s cubic-bezier(0.4, 0, 0.2, 1);
  }

  .header-brand:hover .logo-wrapper {
    transform: translateY(-1px) scale(1.02);
  }

  .brand-logo-q {
    height: 3.25rem; /* ~52px tall — bold, noticeable, commanding */
    width: auto;
    object-fit: contain;
    display: block;
    filter: drop-shadow(0 2px 14px rgba(255, 117, 21, 0.4));
    transition: filter 0.25s ease;
  }

  .header-brand:hover .brand-logo-q {
    filter: drop-shadow(0 4px 22px rgba(255, 117, 21, 0.7));
  }

  .brand-suffix {
    font-size: 1.9rem; /* Proportionally matched to Q height */
    font-weight: 800;
    letter-spacing: -0.045em;
    color: #ffffff;
    line-height: 1;
    margin-left: -3px; /* Seamless fit with the curve of the Q */
    font-family: var(--font-heading);
  }

  /* --- Navigation Links --- */
  .header-links {
    display: flex;
    align-items: center;
    gap: var(--space-xl);
    list-style: none;
    padding: 0;
  }

  .header-links a {
    color: var(--color-dark-text-muted);
    font-size: 0.9375rem;
    font-weight: 500;
    text-decoration: none;
    padding: var(--space-xs) 0;
    transition: color var(--transition-fast);
    position: relative;
  }

  .header-links a:hover,
  .header-links a.active {
    color: #ffffff;
  }

  .header-links a.active::after {
    content: "";
    position: absolute;
    bottom: -2px;
    left: 0;
    right: 0;
    height: 2px;
    background: var(--gradient-brand);
    border-radius: 1px;
  }

  .header-cta {
    padding: 0.625rem 1.375rem !important;
    border-radius: var(--radius-md);
    background: var(--gradient-brand);
    color: #ffffff !important;
    font-weight: 600 !important;
    transition: all var(--transition-base) !important;
    box-shadow: 0 2px 10px var(--color-accent-glow);
  }

  .header-cta:hover {
    transform: translateY(-1px);
    box-shadow: 0 4px 18px var(--color-accent-glow);
  }

  .header-cta::after {
    display: none !important;
  }

  /* --- Theme Toggle Button --- */
  .theme-toggle {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2.35rem;
    height: 2.35rem;
    border-radius: 9999px;
    background: rgba(255, 255, 255, 0.08);
    border: 1px solid rgba(255, 255, 255, 0.16);
    color: #e2e8f0;
    cursor: pointer;
    transition: all var(--transition-base);
    padding: 0;
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.15), inset 0 1px 0 rgba(255, 255, 255, 0.2);
  }

  .theme-toggle:hover {
    background: rgba(255, 255, 255, 0.18);
    border-color: rgba(255, 255, 255, 0.35);
    color: #ffffff;
    transform: translateY(-1px) scale(1.04);
  }

  /* Default dark mode icon states */
  .sun-icon {
    display: block;
    color: #fbbf24;
  }
  .moon-icon {
    display: none;
    color: #818cf8;
  }

  /* ===== LIGHT MODE HEADER STYLES (ASH FROSTED GLASS) ===== */
  :global([data-theme="light"]) .header {
    background: rgba(234, 236, 240, 0.85);
    border-bottom: 1px solid rgba(208, 213, 221, 0.85);
    box-shadow: 0 4px 20px rgba(16, 24, 40, 0.06);
  }

  :global([data-theme="light"]) .brand-suffix {
    color: #101828;
  }

  :global([data-theme="light"]) .header-links a {
    color: #475467;
  }

  :global([data-theme="light"]) .header-links a:hover,
  :global([data-theme="light"]) .header-links a.active {
    color: #101828;
  }

  :global([data-theme="light"]) .theme-toggle {
    background: rgba(16, 24, 40, 0.06);
    border-color: rgba(16, 24, 40, 0.15);
    color: #344054;
    box-shadow: 0 2px 6px rgba(16, 24, 40, 0.05), inset 0 1px 0 rgba(255, 255, 255, 0.5);
  }

  :global([data-theme="light"]) .theme-toggle:hover {
    background: rgba(16, 24, 40, 0.12);
    border-color: rgba(16, 24, 40, 0.25);
    color: #101828;
  }

  :global([data-theme="light"]) .sun-icon {
    display: none;
  }

  :global([data-theme="light"]) .moon-icon {
    display: block;
  }

  /* Responsive styling */
  @media (max-width: 640px) {
    .header-nav {
      height: 4.5rem;
    }

    .brand-logo-q {
      height: 2.35rem; /* Still clearly noticeable on mobile */
    }

    .brand-suffix {
      font-size: 1.45rem;
      display: inline-block; /* Kept visible on mobile */
    }

    .header-links {
      gap: var(--space-sm);
    }

    .header-links a {
      font-size: 0.8125rem;
    }

    .theme-toggle {
      width: 2.1rem;
      height: 2.1rem;
    }

    .header-cta {
      padding: 0.45rem 0.85rem !important;
      font-size: 0.8125rem !important;
    }
  }

  @media (max-width: 440px) {
    .header-links {
      gap: 0.35rem;
    }

    .header-links a {
      font-size: 0.75rem;
    }

    .theme-toggle {
      width: 1.95rem;
      height: 1.95rem;
    }

    .header-cta {
      padding: 0.375rem 0.65rem !important;
      font-size: 0.75rem !important;
    }

    .brand-logo-q {
      height: 2.1rem;
    }

    .brand-suffix {
      font-size: 1.3rem;
    }
  }
</style>

<script>
  function setupThemeToggle() {
    const toggle = document.getElementById("theme-toggle");
    if (!toggle) return;

    // Remove any previously bound listeners by cloning
    const freshToggle = toggle.cloneNode(true);
    toggle.parentNode?.replaceChild(freshToggle, toggle);

    freshToggle.addEventListener("click", () => {
      const current = document.documentElement.getAttribute("data-theme") || "dark";
      const next = current === "dark" ? "light" : "dark";
      document.documentElement.setAttribute("data-theme", next);
      localStorage.setItem("quake-theme", next);
      
      const metaTheme = document.getElementById("meta-theme-color");
      if (metaTheme) {
        metaTheme.setAttribute("content", next === "light" ? "#ffffff" : "#0b0f1a");
      }
    });
  }

  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", setupThemeToggle);
  } else {
    setupThemeToggle();
  }
  document.addEventListener("astro:page-load", setupThemeToggle);
</script>
