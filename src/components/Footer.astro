---
const currentYear = new Date().getFullYear();
---
<footer class="footer">
  <div class="container footer-content">
    <div class="footer-top">
      <div class="footer-brand-section">
        <a href="/" class="footer-brand" aria-label="Quake home">
          <img src="/images/logo-q-transparent.png" alt="" class="footer-logo-q" width="591" height="794" loading="lazy" />
          <span class="brand-suffix">uake</span>
        </a>
        <p class="footer-tagline">Software and thoughtful technology<br />for growing businesses.</p>
      </div>
      <nav class="footer-nav" aria-label="Footer navigation">
        <div class="footer-col"><h4>Explore</h4><ul><li><a href="/about/">About</a></li><li><a href="/services/">Services</a></li><li><a href="/work/">Work</a></li><li><a href="/contact/">Contact</a></li></ul></div>
        <div class="footer-col"><h4>What we build</h4><ul><li><a href="/services/">Web applications</a></li><li><a href="/services/">AI integrations</a></li><li><a href="/services/">Online stores</a></li></ul></div>
      </nav>
    </div>
    <div class="footer-bottom"><p>© {currentYear} Quake</p><p class="footer-location">Based in India · Working worldwide</p></div>
  </div>
</footer>
<style>
  .footer { padding:clamp(3rem,6vw,5rem) 0 1.5rem; }
  .footer-content { display:flex; flex-direction:column; gap:3rem; }
  .footer-top { display:flex; justify-content:space-between; gap:3rem; flex-wrap:wrap; }
  .footer-brand-section { max-width:22rem; }
  .footer-brand { display:inline-flex; align-items:center; text-decoration:none; margin-bottom:1rem; }
  .footer-logo-q { height:35px; width:auto; object-fit:contain; }
  .brand-suffix { margin-left:-2px; color:#1d1d1f; font-size:1.55rem; font-weight:600; letter-spacing:-.045em; }
  .footer-tagline { font-size:.95rem; }
  .footer-nav { display:flex; gap:clamp(2rem,6vw,6rem); }
  .footer-col h4 { font-size:.9rem; margin-bottom:1rem; }
  .footer-col ul { display:flex; flex-direction:column; gap:.65rem; list-style:none; padding:0; }
  .footer-col a { text-decoration:none; font-size:.9rem; }
  .footer-bottom { display:flex; justify-content:space-between; gap:1rem; flex-wrap:wrap; padding-top:1.25rem; border-top:1px solid #d2d2d7; font-size:.82rem; }
  @media(max-width:600px) { .footer-top,.footer-bottom { flex-direction:column; } .footer-nav { gap:2rem; } }
</style>
