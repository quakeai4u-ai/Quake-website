---
/*
  PROJECT DETAIL PAGE — Premium Version
*/

import BaseLayout from "../../layouts/BaseLayout.astro";
import { getCollection, render } from "astro:content";

export async function getStaticPaths() {
  const projects = await getCollection("projects");
  return projects.map((project) => ({
    params: { slug: project.id },
    props: { project },
  }));
}

const { project } = Astro.props;
const { Content } = await render(project);
const { title, description, category, tags, liveUrl, githubUrl, projectType } =
  project.data;

const typeLabels: Record<string, string> = {
  independent: "Independent Project",
  client: "Client Project",
  "open-source": "Open Source",
};
---

<BaseLayout title={title} description={description}>
  <!-- Project Header (dark) -->
  <section class="project-hero">
    <div class="project-hero-bg" aria-hidden="true"></div>
    <div class="container project-hero-content">
      <a href="/work/" class="back-link animate-fade-in-up">
        <svg width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true">
          <path d="M13 8H3M7 4L3 8l4 4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
        Back to all projects
      </a>

      <h1 class="animate-fade-in-up delay-100">{title}</h1>
      <p class="project-desc animate-fade-in-up delay-200">{description}</p>

      <div class="project-meta animate-fade-in-up delay-300">
        <span class="meta-badge">{category}</span>
        <span class="meta-badge">{typeLabels[projectType] || projectType}</span>
      </div>

      {tags.length > 0 && (
        <div class="project-tags animate-fade-in-up delay-300">
          {tags.map((tag) => (
            <span class="tag-dark">{tag}</span>
          ))}
        </div>
      )}

      <div class="project-links animate-fade-in-up delay-400">
        {liveUrl && (
          <a href={liveUrl} target="_blank" rel="noopener noreferrer" class="btn btn-primary-dark">
            View Live Site
            <svg width="14" height="14" viewBox="0 0 16 16" fill="none" aria-hidden="true">
              <path d="M5 3h8v8M13 3L5 11" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          </a>
        )}
        {githubUrl && (
          <a href={githubUrl} target="_blank" rel="noopener noreferrer" class="btn btn-secondary-dark">
            Source Code
            <svg width="14" height="14" viewBox="0 0 16 16" fill="none" aria-hidden="true">
              <path d="M5 3h8v8M13 3L5 11" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          </a>
        )}
      </div>
    </div>
  </section>

  <hr class="gradient-divider" />

  <!-- Project Content -->
  <section class="section">
    <div class="container">
      <article class="project-content reveal">
        <Content />
      </article>

      <footer class="project-footer reveal">
        <a href="/work/" class="back-link-bottom">
          <svg width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true">
            <path d="M13 8H3M7 4L3 8l4 4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
          Back to all projects
        </a>
      </footer>
    </div>
  </section>
</BaseLayout>

<style>
  /* ===== PROJECT HERO ===== */
  .project-hero {
    position: relative;
    background: var(--color-dark-bg);
    padding: 8rem 0 4rem;
    overflow: hidden;
  }

  .project-hero-bg {
    position: absolute;
    inset: 0;
    background:
      radial-gradient(ellipse at 20% 0%, rgba(99, 102, 241, 0.15), transparent 50%),
      radial-gradient(ellipse at 80% 100%, rgba(139, 92, 246, 0.1), transparent 50%);
  }

  .project-hero-content {
    position: relative;
    max-width: var(--max-width-narrow);
  }

  .back-link {
    display: inline-flex;
    align-items: center;
    gap: var(--space-sm);
    color: var(--color-dark-text-muted);
    font-size: 0.875rem;
    margin-bottom: var(--space-xl);
    transition: color var(--transition-fast);
  }

  .back-link:hover {
    color: #ffffff;
    text-decoration: none;
  }

  .project-hero h1 {
    color: #ffffff;
    margin-bottom: var(--space-md);
  }

  .project-desc {
    color: var(--color-dark-text-muted);
    font-size: clamp(1.0625rem, 1.5vw, 1.25rem);
    line-height: 1.7;
    margin-bottom: var(--space-lg);
    max-width: clamp(34rem, 50vw, 48rem);
  }

  .project-meta {
    display: flex;
    gap: var(--space-sm);
    margin-bottom: var(--space-md);
    flex-wrap: wrap;
  }

  .meta-badge {
    font-size: 0.75rem;
    font-weight: 600;
    padding: 0.25rem 0.75rem;
    border-radius: 9999px;
    background: rgba(255, 255, 255, 0.06);
    border: 1px solid rgba(255, 255, 255, 0.1);
    color: var(--color-dark-text-muted);
  }

  .project-tags {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-sm);
    margin-bottom: var(--space-lg);
  }

  .tag-dark {
    font-size: 0.75rem;
    font-weight: 500;
    padding: 0.25rem 0.625rem;
    border-radius: 9999px;
    background: rgba(99, 102, 241, 0.15);
    color: #a5b4fc;
    border: 1px solid rgba(255, 255, 255, 0.08);
  }

  .project-links {
    display: flex;
    gap: var(--space-md);
    flex-wrap: wrap;
  }

  /* ===== PROJECT CONTENT (Markdown) ===== */
  .project-content {
    max-width: var(--max-width-narrow);
  }

  .project-content :global(h2) {
    margin-top: var(--space-2xl);
    margin-bottom: var(--space-md);
    padding-top: var(--space-lg);
  }

  .project-content :global(h3) {
    margin-top: var(--space-xl);
    margin-bottom: var(--space-sm);
  }

  .project-content :global(p) {
    color: var(--color-light-text-muted);
    line-height: 1.8;
    margin-bottom: var(--space-md);
    font-size: 1.0625rem;
  }

  .project-content :global(ul),
  .project-content :global(ol) {
    color: var(--color-light-text-muted);
    padding-left: var(--space-lg);
    margin-bottom: var(--space-md);
    display: flex;
    flex-direction: column;
    gap: var(--space-sm);
    font-size: 1.0625rem;
  }

  .project-content :global(blockquote) {
    border-left: 3px solid var(--color-accent-1);
    padding: var(--space-md) var(--space-lg);
    margin: var(--space-xl) 0;
    background: var(--color-accent-subtle);
    border-radius: 0 var(--radius-md) var(--radius-md) 0;
    color: var(--color-light-text-muted);
    font-style: normal;
  }

  .project-content :global(blockquote p) {
    margin-bottom: 0;
  }

  .project-content :global(strong) {
    color: var(--color-light-text);
    font-weight: 600;
  }

  .project-content :global(code) {
    font-size: 0.875em;
    padding: 0.125rem 0.375rem;
    background: var(--color-light-surface);
    border-radius: var(--radius-sm);
    border: 1px solid var(--color-light-border);
  }

  /* ===== FOOTER ===== */
  .project-footer {
    max-width: var(--max-width-narrow);
    margin-top: var(--space-3xl);
    padding-top: var(--space-xl);
    border-top: 1px solid var(--color-light-border);
  }

  .back-link-bottom {
    display: inline-flex;
    align-items: center;
    gap: var(--space-sm);
    color: var(--color-light-text-muted);
    font-size: 0.9375rem;
    font-weight: 500;
    transition: color var(--transition-fast);
  }

  .back-link-bottom:hover {
    color: var(--color-accent-1);
    text-decoration: none;
  }

  /* ===== LIGHT MODE FOR CASE STUDY HERO ===== */
  :global([data-theme="light"]) .project-hero {
    background: linear-gradient(150deg, #fff7ed 0%, #fdf4ff 40%, #f0f9ff 100%);
  }

  :global([data-theme="light"]) .project-hero-bg {
    background:
      radial-gradient(ellipse at 20% 0%, rgba(255, 140, 66, 0.2), transparent 50%),
      radial-gradient(ellipse at 80% 100%, rgba(192, 132, 252, 0.2), transparent 50%);
  }

  :global([data-theme="light"]) .project-hero h1 {
    color: #0f172a;
  }

  :global([data-theme="light"]) .project-desc {
    color: #475569;
  }

  :global([data-theme="light"]) .back-link {
    color: #64748b;
  }

  :global([data-theme="light"]) .back-link:hover {
    color: #0f172a;
  }

  :global([data-theme="light"]) .meta-badge {
    background: #f1f5f9;
    border-color: #e2e8f0;
    color: #475569;
  }

  :global([data-theme="light"]) .tag-dark {
    background: rgba(99, 102, 241, 0.08);
    color: #6366f1;
    border-color: rgba(99, 102, 241, 0.15);
  }
</style>
